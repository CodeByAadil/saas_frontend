# =============================================================================
#  ProjectAI — Frontend Environment Variables  (Next.js)
#  Copy this file:  cp .env.local.example .env.local
#  Then fill in every value marked  ← REQUIRED
#
#  NEXT_PUBLIC_* variables are embedded into the browser bundle at build time.
#  Never put secrets in NEXT_PUBLIC_* — they are visible to all users.
# =============================================================================

# ── Backend API ───────────────────────────────────────────────────────────────
# The base URL of your Express backend (no trailing slash).
# Development:  http://localhost:4000/api
# Production:   https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api   # ← REQUIRED

# ── App URL ───────────────────────────────────────────────────────────────────
# The public URL of this Next.js app.
# Used for OAuth redirects and invite email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000   # ← REQUIRED

# ── Stripe (billing UI) ───────────────────────────────────────────────────────
# Price IDs for each paid plan — find them in:
#   Stripe Dashboard → Products → [your plan] → Pricing → API ID
# Format:  price_XXXXXXXXXXXXXXXXXXXXXXXX
#
# Test mode price IDs start with price_ and work with sk_test_ keys.
# Switching to live mode requires replacing both these AND the backend STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_XXXXXXXXXXXXXXXXXXXXXXXX          # ← REQUIRED for billing
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_XXXXXXXXXXXXXXXXXXXXXXXX   # ← REQUIRED for billing

# ── Optional / Advanced ───────────────────────────────────────────────────────
# Only needed if you add NextAuth.js on top of the custom JWT system.
# Leave blank if using the built-in JWT auth (default).
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=CHANGE_ME_minimum_32_chars_random_string
